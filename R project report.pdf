/T (# Discretize into bins get_joint_distribution <- function\(x, y, bins = 5\) {  x_cut <- cut\(x, breaks = bins\)  y_cut <- cut\(y, breaks = bins\)  joint_table <- table\(x_cut, y_cut\)  joint_prob <- prop.table\(joint_table\) # joint probability matrix  return\(joint_prob\) })
/E (# Discretize into bins get_joint_distribution <- function\(x, y, bins = 5\) {  x_cut <- cut\(x, breaks = bins\)  y_cut <- cut\(y, breaks = bins\)  joint_table <- table\(x_cut, y_cut\)  joint_prob <- prop.table\(joint_table\) # joint probability matrix  return\(joint_prob\) })
/Pg 12 0 R
/K [0]
>>
