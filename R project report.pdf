/E (# Compute marginal pmfs get_marginals <- function\(joint_prob\) {  x_marginal <- rowSums\(joint_prob\)  y_marginal <- colSums\(joint_prob\)  return\(list\(x = x_marginal, y = y_marginal\)\) })
